{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_shortName__",
  "version": "2.1.4",
  "description": "__MSG_appDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-note": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "__MSG_toggleDescription__"
    },
    "new-note": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_newDescription__"
    },
    "toggle-click-through": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_clickThroughDescription__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keyboard-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["fullscreen-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/collapsed-meteor.png"],
      "matches": ["<all_urls>"]
    }
  ]
}

